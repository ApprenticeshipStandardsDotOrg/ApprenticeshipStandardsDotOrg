<% field.resource.associated_occupation_standards.each do |occupation_standard| %>
  <div>
    <strong><%= occupation_standard.title %></strong>
    <% if policy(occupation_standard).show? %>
      <%= link_to "Admin", admin_occupation_standard_path(occupation_standard) %>
    <% end %>
    <%= link_to "Public", occupation_standard_path(occupation_standard), target: "_blank", rel: "noopener" %>
  </div>
<% end %>
