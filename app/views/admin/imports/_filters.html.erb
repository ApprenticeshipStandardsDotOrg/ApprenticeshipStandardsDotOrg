<% search_terms = admin_filter_search_terms_without("needs_redaction", "redacted", "has_occupation_standard") %>
<% active_redaction = "needs_redaction" if admin_filter_value("needs_redaction") %>
<% active_redaction = "redacted" if admin_filter_value("redacted") %>
<% active_has_standard = admin_filter_value("has_occupation_standard") %>
<% active_filter_count = (active_redaction.present? ? 1 : 0) + (active_has_standard.present? ? 1 : 0) %>

<details class="relative">
  <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-800 hover:border-blue-500 hover:text-blue-700">
    Filters
    <% if active_filter_count.positive? %>
      <span class="rounded-full bg-blue-700 px-2 py-0.5 text-xs font-semibold text-white"><%= active_filter_count %></span>
    <% end %>
  </summary>

  <div class="absolute right-0 z-20 mt-2 w-72 rounded-md border border-gray-200 bg-white p-3 shadow-lg">
    <div class="mb-3">
      <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">Redaction</div>
      <div class="flex flex-wrap gap-2">
        <% [["Needs Redaction", "needs_redaction"], ["Redacted", "redacted"]].each do |label, value| %>
          <% selected = active_redaction == value %>
          <% next_redaction = selected ? nil : value %>
          <% search = admin_filter_search(search_terms, next_redaction => next_redaction.present?, "has_occupation_standard" => active_has_standard) %>
          <%= link_to label,
                admin_filter_url(search, "pdf_only" => next_redaction.present?),
                class: admin_filter_option_class(selected),
                aria: {pressed: selected} %>
        <% end %>
      </div>
    </div>

    <div>
      <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">Occupation Standard</div>
      <div class="flex flex-wrap gap-2">
        <% [["Has Standard", "true"], ["No Standard", "false"]].each do |label, value| %>
          <% selected = active_has_standard == value %>
          <% next_has_standard = selected ? nil : value %>
          <% search = admin_filter_search(search_terms, active_redaction => active_redaction.present?, "has_occupation_standard" => next_has_standard) %>
          <%= link_to label,
                admin_filter_url(search, "pdf_only" => active_redaction.present?),
                class: admin_filter_option_class(selected),
                aria: {pressed: selected} %>
        <% end %>
      </div>
    </div>

    <% if active_filter_count.positive? %>
      <div class="mt-3 border-t border-gray-200 pt-3">
        <%= link_to "Clear filters",
              admin_filter_url(search_terms.join(" ")),
              class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  </div>
</details>
