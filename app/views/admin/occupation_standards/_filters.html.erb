<% search_terms = admin_filter_search_terms_without("sample_set", "source") %>
<% active_sample_set = admin_filter_value("sample_set") %>
<% active_sources = admin_filter_value("source").to_s.split(",").reject(&:blank?) %>
<% active_filter_count = active_sources.count + (active_sample_set.present? ? 1 : 0) %>

<details class="relative">
  <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-800 hover:border-blue-500 hover:text-blue-700">
    Filters
    <% if active_filter_count.positive? %>
      <span class="rounded-full bg-blue-700 px-2 py-0.5 text-xs font-semibold text-white"><%= active_filter_count %></span>
    <% end %>
  </summary>

  <div class="absolute right-0 z-20 mt-2 w-80 rounded-md border border-gray-200 bg-white p-3 shadow-lg">
    <div class="mb-3">
      <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">Sample</div>
      <div class="flex flex-wrap gap-2">
        <% [["Sample set", "true"], ["Not sample set", "false"]].each do |label, value| %>
          <% selected = active_sample_set == value %>
          <% next_sample_set = selected ? nil : value %>
          <% search = admin_filter_search(search_terms, sample_set: next_sample_set, source: active_sources) %>
          <%= link_to label,
                admin_filter_url(search),
                class: admin_filter_option_class(selected),
                aria: {pressed: selected} %>
        <% end %>
      </div>
    </div>

    <div>
      <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">Source</div>
      <div class="flex flex-wrap gap-2">
        <% OccupationStandard.sources.each_key do |source| %>
          <% selected = active_sources.include?(source) %>
          <% next_sources = selected ? active_sources - [source] : active_sources + [source] %>
          <% search = admin_filter_search(search_terms, sample_set: active_sample_set, source: next_sources) %>
          <%= link_to source.titleize,
                admin_filter_url(search),
                class: admin_filter_option_class(selected),
                aria: {pressed: selected} %>
        <% end %>
      </div>
    </div>

    <% if active_filter_count.positive? %>
      <div class="mt-3 border-t border-gray-200 pt-3">
        <%= link_to "Clear filters",
              admin_filter_url(search_terms.join(" ")),
              class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  </div>
</details>
