<% search_terms = admin_filter_search_terms_without("has_imports") %>
<% active_has_imports = admin_filter_value("has_imports") %>

<details class="relative">
  <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-800 hover:border-blue-500 hover:text-blue-700">
    Filters
    <% if active_has_imports.present? %>
      <span class="rounded-full bg-blue-700 px-2 py-0.5 text-xs font-semibold text-white">1</span>
    <% end %>
  </summary>

  <div class="absolute right-0 z-20 mt-2 w-64 rounded-md border border-gray-200 bg-white p-3 shadow-lg">
    <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">Imports</div>
    <div class="flex flex-wrap gap-2">
      <% [["Has imports", "true"], ["No imports", "false"]].each do |label, value| %>
        <% selected = active_has_imports == value %>
        <% next_value = selected ? nil : value %>
        <% search = admin_filter_search(search_terms, has_imports: next_value) %>
        <%= link_to label,
              admin_filter_url(search),
              class: admin_filter_option_class(selected),
              aria: {pressed: selected} %>
      <% end %>
    </div>

    <% if active_has_imports.present? %>
      <div class="mt-3 border-t border-gray-200 pt-3">
        <%= link_to "Clear filters",
              admin_filter_url(search_terms.join(" ")),
              class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  </div>
</details>
