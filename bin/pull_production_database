#!/usr/bin/env ruby

require "fileutils"
require "shellwords"
require "etc"

APP_ROOT = File.expand_path("..", __dir__)

HEROKU_APP = "apprenticeship-standards-dot-o"
DATABASE = "apprenticeship_standards_development"
DUMP_PATH = File.join(APP_ROOT, "tmp", "heroku", "latest.dump")

def system!(*command, env: {}, **options)
  puts "\n==> #{command.shelljoin}"
  system(env, *command, exception: true, **options)
end

puts "Heroku app: #{HEROKU_APP}"
puts "Development database: #{DATABASE}"

puts
puts "This will replace your local development database with production data."
print %(Type "#{DATABASE}" to continue: )
abort "Aborted." unless $stdin.gets&.chomp == DATABASE

FileUtils.mkdir_p(File.dirname(DUMP_PATH))

system!("heroku", "pg:backups:capture", "--app", HEROKU_APP)
system!("heroku", "pg:backups:download", "--app", HEROKU_APP, "--output", DUMP_PATH)

terminate_sql = <<~SQL
  SELECT pg_terminate_backend(pid)
  FROM pg_stat_activity
  WHERE datname = '#{DATABASE}'
    AND pid <> pg_backend_pid();
SQL

psql_commands = [
  ["postgres", terminate_sql],
  ["postgres", "DROP DATABASE IF EXISTS #{DATABASE};"],
  ["postgres", "CREATE DATABASE #{DATABASE};"],
  [DATABASE, "CREATE SCHEMA IF NOT EXISTS heroku_ext; CREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA heroku_ext;"]
]

psql_commands.each do |dbname, command|
  system!("psql", "--quiet", "--no-psqlrc", "--dbname", dbname, "--command", command)
end

system!(
  "pg_restore",
  "--verbose",
  "--clean",
  "--if-exists",
  "--no-acl",
  "--no-owner",
  "--dbname",
  DATABASE,
  DUMP_PATH
)

post_restore_commands = [
  "DROP EXTENSION IF EXISTS pg_stat_statements;",
  "ALTER EXTENSION pgcrypto SET SCHEMA public;",
  "DROP SCHEMA IF EXISTS heroku_ext;"
]

post_restore_commands.each do |command|
  system!("psql", "--quiet", "--no-psqlrc", "--dbname", DATABASE, "--command", command)
end

puts "\n#{DATABASE} has been restored. Rebuilding development Elasticsearch..."

reindex_environment = {
  "RAILS_ENV" => "development",
  "POSTGRES_DB" => DATABASE,
  "POSTGRES_USER" => ENV["POSTGRES_USER"] || ENV["PGUSER"] || Etc.getpwuid.name
}

begin
  system!(
    "bundle", "exec", "rails", "development:reindex",
    env: reindex_environment,
    chdir: APP_ROOT
  )
rescue => error
  warn "The database restore succeeded, but Elasticsearch rebuilding failed: #{error.message}"
  retry_environment = reindex_environment.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
  warn "Fix Elasticsearch, then retry with #{retry_environment} bundle exec rails development:reindex."
  warn "The database pull does not need to be repeated."
  exit 1
end

puts "\nDone. #{DATABASE} has been restored from #{HEROKU_APP} and development search rebuilt."
